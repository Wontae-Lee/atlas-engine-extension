{
  "name": "atlas-engine",
  "displayName": "atlas-engine",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "dev:debug": "python3 scripts/dev.py --debug",
    "dev:debug:break": "python3 scripts/dev.py --debug-break",
    "vscode:prepublish": "npm run package",
    "compile": "npm run manifest && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "npm run manifest && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run manifest && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "manifest": "python3 scripts/generate_manifest.py"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "atlas-engine-simulation",
          "title": "ATLAS SIMULATION",
          "icon": "media/atlas-engine-logo.svg"
        }
      ]
    },
    "views": {
      "atlas-engine-simulation": [
        {
          "id": "atlas-engine.simulation",
          "name": "SIMULATION"
        }
      ]
    },
    "commands": [
      {
        "command": "atlas-engine.project.create",
        "title": "Atlas Engine: Create Project"
      },
      {
        "command": "atlas-engine.project.open",
        "title": "Atlas Engine: Open Project"
      },
      {
        "command": "atlas-engine.backend.select",
        "title": "Atlas Engine: Select Backend"
      },
      {
        "command": "atlas-engine.backend.check",
        "title": "Atlas Engine: Check Backend"
      },
      {
        "command": "atlas-engine.scene.open",
        "title": "Atlas Engine: Open Simulation"
      },
      {
        "command": "atlas-engine.layout.show",
        "title": "Atlas Engine: Show Layout"
      },
      {
        "command": "atlas-engine.simulation.validate",
        "title": "Atlas Engine: Validate Simulation"
      },
      {
        "command": "atlas-engine.simulation.apply",
        "title": "Atlas Engine: Apply Simulation"
      },
      {
        "command": "atlas-engine.parameter.edit",
        "title": "Atlas Engine: Edit Parameter"
      },
      {
        "command": "atlas-engine.parameter.add",
        "title": "Atlas Engine: Add Object"
      },
      {
        "command": "atlas-engine.parameter.remove",
        "title": "Atlas Engine: Remove Object"
      },
      {
        "command": "atlas-engine.asset.import",
        "title": "Atlas Engine: Import OBJ Asset"
      },
      {
        "command": "atlas-engine.log.show",
        "title": "Atlas Engine: Show Log"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "atlas-engine.project.open",
          "when": "resourceFilename == atlas.project.json",
          "group": "atlas@1"
        },
        {
          "command": "atlas-engine.asset.import",
          "when": "resourceExtname == .obj",
          "group": "atlas@2"
        }
      ],
      "view/title": [
        {
          "command": "atlas-engine.project.create",
          "when": "view == atlas-engine.simulation",
          "group": "navigation@1"
        },
        {
          "command": "atlas-engine.simulation.validate",
          "when": "view == atlas-engine.simulation",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "atlas-engine.parameter.edit",
          "when": "view == atlas-engine.simulation && viewItem == atlasObject",
          "group": "inline@1"
        },
        {
          "command": "atlas-engine.parameter.add",
          "when": "view == atlas-engine.simulation && viewItem == atlasArray",
          "group": "inline@1"
        },
        {
          "command": "atlas-engine.parameter.remove",
          "when": "view == atlas-engine.simulation && viewItem == atlasRemovable",
          "group": "inline@2"
        }
      ]
    }
  }
}
