{
  "name": "atlas-engine",
  "displayName": "atlas-engine",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "dev:debug": "python3 scripts/dev.py --debug",
    "dev:debug:break": "python3 scripts/dev.py --debug-break",
    "vscode:prepublish": "npm run package",
    "compile": "npm run manifest && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "npm run manifest && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run manifest && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "manifest": "python3 scripts/generate_manifest.py"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atlas-engine",
          "title": "ATLAS",
          "icon": "media/atlas-engine-logo.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "atlas-engine-inspector",
          "title": "ATLAS INSPECTOR",
          "icon": "media/atlas-engine-logo.svg"
        }
      ],
      "panel": [
        {
          "id": "atlas-engine-logs",
          "title": "SIMULATION LOG",
          "icon": "media/atlas-engine-logo.svg"
        }
      ]
    },
    "views": {
      "atlas-engine": [
        {
          "id": "atlas-engine.domain",
          "name": "DOMAIN",
          "visibility": "collapsed"
        },
        {
          "id": "atlas-engine.assets",
          "name": "ASSETS"
        },
        {
          "id": "atlas-engine.materials",
          "name": "MATERIALS"
        },
        {
          "id": "atlas-engine.geometry",
          "name": "GEOMETRY"
        },
        {
          "id": "atlas-engine.sources",
          "name": "SOURCES"
        },
        {
          "id": "atlas-engine.boundaries",
          "name": "BOUNDARIES"
        },
        {
          "id": "atlas-engine.sinks",
          "name": "SINKS"
        },
        {
          "id": "atlas-engine.solvers",
          "name": "SOLVERS"
        },
        {
          "id": "atlas-engine.output",
          "name": "OUTPUT"
        }
      ],
      "atlas-engine-inspector": [
        {
          "id": "atlas-engine.inspector",
          "name": "INSPECTOR"
        },
        {
          "id": "atlas-engine.selection",
          "name": "SELECTION"
        },
        {
          "id": "atlas-engine.properties",
          "name": "PROPERTIES"
        }
      ],
      "atlas-engine-logs": [
        {
          "id": "atlas-engine.logs",
          "name": "SIMULATION LOG"
        }
      ]
    },
    "commands": [
      {
        "command": "atlas-engine.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "atlas-engine.backend.select",
        "title": "Atlas Engine: Select Backend"
      },
      {
        "command": "atlas-engine.backend.check",
        "title": "Atlas Engine: Check Backend"
      },
      {
        "command": "atlas-engine.layout.show",
        "title": "Atlas Engine: Show Layout"
      },
      {
        "command": "atlas-engine.project.action",
        "title": "Atlas Engine: Edit Case"
      },
      {
        "command": "atlas-engine.scene.open",
        "title": "Atlas Engine: Open Scene"
      },
      {
        "command": "atlas-engine.results.open",
        "title": "Atlas Engine: Open Results"
      }
    ]
  }
}
